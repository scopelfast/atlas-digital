# Copie para .env e ajuste (nunca commite o .env real).
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env   (Windows PowerShell)

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL (alinhado ao docker-compose.yml na raiz do projeto) ---
# compose mapeia host 5433 -> container 5432 (convive com Postgres nativo Windows na 5432).
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=atlas_digital
DB_USER=atlas
DB_PASS=atlas_dev_secret

# Pool (opcional)
# DB_POOL_MAX=100
# DB_POOL_MIN=15

# --- JWT (obrigatório: troque por valores longos e aleatórios) ---
JWT_SECRET=troque_por_string_longa_e_aleatoria
JWT_REFRESH_SECRET=troque_outra_string_longa_e_aleatoria

# --- Leitura pública de settings (GET /public-settings/:key?token=...) ---
# Deve coincidir com o token enviado pelo frontend (hooks/useSettings — valor padrão "wtV").
ENV_TOKEN=wtV

# --- Redis (sessões Baileys + filas Bull) ---
REDIS_URI=redis://127.0.0.1:6379

# Opcional: segunda instância Redis para filas de ACK (se vazio, usa REDIS_URI)
# REDIS_URI_ACK=

REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

# Extras usados no instalador zappro / produção
# PROXY_PORT=
# USER_LIMIT=
# CONNECTIONS_LIMIT=
# CLOSED_SEND_BY_ME=true
