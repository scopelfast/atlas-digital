# Copiar para .env (não commitar o .env)
#
# Desenvolvimento (proxy no package.json aponta para a API):
# REACT_APP_BACKEND_URL=
# REACT_APP_SOCKET_URL=http://localhost:8090
#
# Com localhost no .env, o cliente alinha o host do socket ao da página (ex.: 127.0.0.1 ou IP da LAN).
# Acesso por IP na rede: no backend, FRONTEND_URL pode listar várias origens separadas por vírgula
# (ex.: https://app.teudominio.com,http://192.168.1.10:3000) — em dev o socket também aceita http://<IP-privado>:3000.
#
# Produção ou API directa sem proxy:
# REACT_APP_BACKEND_URL=https://api.teudominio.com
# REACT_APP_SOCKET_URL=https://api.teudominio.com
REACT_APP_BACKEND_URL=
REACT_APP_SOCKET_URL=http://localhost:8090
